#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT_DIR/lib/common.sh"

DRY_RUN=0
ASSUME_YES=0

usage() {
    cat <<USAGE
Uso: rokko-setup [opções]

Assistente guiado e modular do RokkoDesk para Alpine Linux.

Opções:
  --plan       mostra o plano sem alterar o sistema
  --yes        aceita as escolhas padrão e executa sem perguntas
  --help       mostra esta ajuda
USAGE
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --plan) DRY_RUN=1 ;;
        --yes) ASSUME_YES=1 ;;
        --help|-h) usage; exit 0 ;;
        *) die "Opção desconhecida: $1" ;;
    esac
    shift
done

require_alpine

NETWORK_BACKEND=keep
CHOICE_FLATPAK=0
CHOICE_TOOLS=0

show_plan() {
    printf '\n%s\n' "Plano selecionado:"
    case "$NETWORK_BACKEND" in
        networkmanager) printf '  [x] Rede: NetworkManager\n' ;;
        native) printf '  [x] Rede: gerenciador nativo do Alpine (ifupdown-ng/networking)\n' ;;
        restore-native) printf '  [x] Rede: restaurar gerenciador nativo\n' ;;
        keep) printf '  [ ] Rede: manter configuração atual\n' ;;
    esac
    [ "$CHOICE_FLATPAK" -eq 1 ] && printf '  [x] Flatpak\n' || printf '  [ ] Flatpak\n'
    [ "$CHOICE_TOOLS" -eq 1 ] && printf '  [x] Ferramentas básicas\n' || printf '  [ ] Ferramentas básicas\n'
}

configure_flatpak() {
    if ask_yes_no "Instalar Flatpak?" "n"; then
        CHOICE_FLATPAK=1
    else
        CHOICE_FLATPAK=0
    fi
}

configure_tools() {
    if ask_yes_no "Instalar ferramentas básicas para desktop e jogos?" "n"; then
        CHOICE_TOOLS=1
    else
        CHOICE_TOOLS=0
    fi
}

interactive_menu() {
    while :; do
        clear_screen
        render_banner
        printf '%s\n\n' "Escolha um tópico para configurar:"
        printf '  1) Rede\n'
        printf '  2) Flatpak\n'
        printf '  3) Ferramentas de desktop e jogos\n'
        printf '  4) Revisar plano\n'
        printf '  5) Sair\n\n'
        printf '%s ' "Escolha [1-5]:"
        IFS= read -r topic || topic=''
        case "$topic" in
            1) ask_network_backend || true ;;
            2) configure_flatpak ;;
            3) configure_tools ;;
            4) return 0 ;;
            5) printf '%s\n' "Até a próxima."; exit 0 ;;
            *) printf '%s\n' "Escolha 1, 2, 3, 4 ou 5."; sleep 1 ;;
        esac
    done
}

if [ "$ASSUME_YES" -eq 1 ]; then
    NETWORK_BACKEND=networkmanager
else
    interactive_menu
fi

show_plan

if [ "$DRY_RUN" -eq 1 ]; then
    printf '\nModo planejamento: nenhuma alteração será feita.\n'
    exit 0
fi

if [ "$ASSUME_YES" -eq 0 ]; then
    ask_yes_no "Aplicar este plano agora?" "n" || { printf '%s\n' "Cancelado."; exit 0; }
fi

require_root

case "$NETWORK_BACKEND" in
    networkmanager) run_module networkmanager ;;
    native|restore-native) run_module native-networking ;;
esac
[ "$CHOICE_FLATPAK" -eq 1 ] && run_module flatpak
[ "$CHOICE_TOOLS" -eq 1 ] && run_module desktop-tools

printf '\nConfiguração concluída.\n'
